{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XS-MLVP/ChipTrace/schemas/object-commit-v1.schema.json",
  "title": "ChipTrace object commit v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_id",
    "committed_at_utc",
    "manifest_sha256",
    "manifest_key",
    "objects"
  ],
  "properties": {
    "schema_version": {"const": "chiptrace.object-commit.v1"},
    "artifact_kind": {"enum": ["release", "buyer_package"]},
    "artifact_id": {"type": "string", "minLength": 1},
    "committed_at_utc": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_key": {"type": "string", "minLength": 1},
    "source_release_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "sha256", "bytes"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"artifact_kind": {"const": "buyer_package"}},
        "required": ["artifact_kind"]
      },
      "then": {"required": ["source_release_manifest_sha256"]},
      "else": {"not": {"required": ["source_release_manifest_sha256"]}}
    }
  ],
  "additionalProperties": false
}
