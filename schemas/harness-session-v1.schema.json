{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XS-MLVP/ChipTrace/schemas/harness-session-v1.schema.json",
  "title": "ChipTrace producer harness session v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_namespace",
    "identity",
    "producer",
    "producer_version",
    "spool_file",
    "spool_offset",
    "streams",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "chiptrace.harness-session.v1"},
    "source_namespace": {"type": "string", "minLength": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "target": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["Relay", "Jsonl"]},
            "value": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "producer": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "retry_max_times": {"type": "integer", "minimum": 20},
    "request_timeout_ms": {"type": "integer", "minimum": 1},
    "max_envelope_bytes": {"type": "integer", "minimum": 1},
    "batch_records": {"type": "integer", "minimum": 1},
    "spool_file": {"type": "string", "const": "events.ndjson"},
    "spool_offset": {"type": "integer", "minimum": 0},
    "emitted_events": {"type": "integer", "minimum": 0},
    "delivered_events": {"type": "integer", "minimum": 0},
    "streams": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "status": {"enum": ["open", "closed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "last_delivery_error": {"type": ["string", "null"]},
    "recovered_tail_bytes": {"type": "integer", "minimum": 0},
    "tool_registry": {"type": ["object", "null"]},
    "tool_registry_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "active_tools": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/active_tool"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["task_session_id", "root_session_id", "traceparent"],
      "properties": {
        "task_session_id": {"type": "string", "minLength": 1},
        "root_session_id": {"type": "string", "minLength": 1},
        "parent_session_id": {"type": ["string", "null"]},
        "goal_id": {"type": ["string", "null"]},
        "agent_id": {"type": ["string", "null"]},
        "branch_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "thread_id": {"type": ["string", "null"]},
        "previous_response_id": {"type": ["string", "null"]},
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{2}-[0-9a-fA-F]{32}-[0-9a-fA-F]{16}-[0-9a-fA-F]{2}(?:-.*)?$"
        }
      },
      "additionalProperties": false
    },
    "active_tool": {
      "type": "object",
      "required": [
        "call_id",
        "name",
        "arguments",
        "initiator",
        "started_at"
      ],
      "properties": {
        "call_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "arguments": {},
        "schema": {"type": ["object", "null"]},
        "schema_provenance": {"type": ["object", "null"]},
        "parent_call_id": {"type": ["string", "null"]},
        "initiator": {"enum": ["assistant", "runtime", "user"]},
        "turn_id": {"type": ["string", "null"]},
        "started_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
