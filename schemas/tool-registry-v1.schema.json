{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XS-MLVP/ChipTrace/schemas/tool-registry-v1.schema.json",
  "title": "ChipTrace Codex runtime Tool Registry v1",
  "type": "object",
  "required": ["schema_version", "producer", "producer_version", "tools"],
  "properties": {
    "schema_version": {"const": "chiptrace.tool-registry.v1"},
    "producer": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runtime_item_type", "tool"],
        "properties": {
          "runtime_item_type": {"type": "string", "minLength": 1},
          "runtime_tool": {"type": "string", "minLength": 1},
          "runtime_namespace": {"type": "string", "minLength": 1},
          "tool": {"$ref": "#/$defs/tool"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "type": {"const": "object"},
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": {"type": "string", "minLength": 1}
                },
                "anyOf": [
                  {"required": ["type"]},
                  {"required": ["oneOf"]},
                  {"required": ["anyOf"]},
                  {"required": ["$ref"]}
                ],
                "additionalProperties": true
              }
            },
            "required": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        },
        "format": {
          "type": "object",
          "required": ["type", "syntax", "definition"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "syntax": {"type": "string", "minLength": 1},
            "definition": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      },
      "anyOf": [
        {"required": ["parameters"]},
        {"required": ["format"]}
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
