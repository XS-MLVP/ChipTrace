{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XS-MLVP/ChipTrace/schemas/assessment-v1.schema.json",
  "title": "ChipTrace trajectory assessment v1",
  "type": "object",
  "required": [
    "trajectory_id",
    "session_id",
    "provider",
    "model",
    "quality",
    "release_decision",
    "content_fingerprint"
  ],
  "properties": {
    "trajectory_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "release_decision": {"enum": ["eligible", "rejected"]},
    "content_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quality": {
      "type": "object",
      "required": ["capture_completeness", "buyer_acceptance", "semantic_quality"],
      "properties": {
        "capture_completeness": {
          "type": "object",
          "required": [
            "policy_version",
            "score",
            "closed",
            "source_request_count",
            "has_stable_session_identity",
            "has_timestamps",
            "has_usage",
            "has_trace_hierarchy",
            "scope"
          ]
        },
        "buyer_acceptance": {
          "type": "object",
          "required": [
            "schema_version",
            "profile",
            "profile_version",
            "score",
            "hard_gate_pass",
            "eligible",
            "minimum_score",
            "metrics",
            "tokens",
            "gates",
            "failure_reasons",
            "warnings",
            "scoring_scope"
          ],
          "properties": {
            "schema_version": {"const": "chiptrace.assessment.v1"},
            "profile": {"enum": ["buyer-v6", "buyer-v7", "buyer-v7-codex-runtime-expanded"]},
            "profile_version": {"type": "string"},
            "score": {"type": "number", "minimum": 0, "maximum": 100},
            "hard_gate_pass": {"type": "boolean"},
            "eligible": {"type": "boolean"},
            "minimum_score": {"type": "number", "minimum": 0, "maximum": 100},
            "metrics": {
              "type": "object",
              "properties": {
                "invalid_tool_arguments": {"type": "integer", "minimum": 0},
                "tool_results_with_explicit_status": {"type": "integer", "minimum": 0},
                "unknown_tool_results": {"type": "integer", "minimum": 0},
                "conflicting_tool_results": {"type": "integer", "minimum": 0},
                "task_start_event_present": {"type": "boolean"},
                "task_terminal_event_present": {"type": "boolean"},
                "task_boundary_attested": {"type": "boolean"},
                "model_evidence_consistent": {"type": "boolean"},
                "provider_identity_attested": {"type": "boolean"},
                "proxy_route_verified": {"type": "boolean"},
                "model_attestation_candidate_count": {"type": "integer", "minimum": 0},
                "non_attestable_api_snapshot_count": {"type": "integer", "minimum": 0},
                "assembly_usage_conflicts": {"type": "integer", "minimum": 0},
                "assembly_tool_execution_conflicts": {"type": "integer", "minimum": 0},
                "assembly_producer_event_conflicts": {"type": "integer", "minimum": 0},
                "rollout_unknown_events": {"type": "integer", "minimum": 0},
                "rollout_unmapped_tools": {"type": "integer", "minimum": 0},
                "runtime_dag_present": {"type": "boolean"},
                "runtime_dag_applicable": {"type": "boolean"},
                "runtime_dag_complete": {"type": "boolean"},
                "runtime_dag_native_events": {"type": "integer", "minimum": 0},
                "runtime_dag_open_nodes": {"type": "integer", "minimum": 0},
                "runtime_dag_unresolved_nodes": {"type": "integer", "minimum": 0},
                "runtime_dag_status_conflicts": {"type": "integer", "minimum": 0},
                "inference_api_conservation_applicable": {"type": "boolean"},
                "inference_api_conservation_complete": {"type": "boolean"},
                "runtime_completed_inferences": {"type": "integer", "minimum": 0},
                "api_snapshots": {"type": "integer", "minimum": 0},
                "matched_runtime_inferences": {"type": "integer", "minimum": 0},
                "missing_api_captures": {"type": "integer", "minimum": 0}
              }
            },
            "tokens": {"type": "object"},
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "pass", "required", "observed", "expected"],
                "properties": {
                  "name": {"type": "string"},
                  "pass": {"type": "boolean"},
                  "required": {"type": "boolean"},
                  "observed": {},
                  "expected": {"type": "string"},
                  "detail": {"type": "string"}
                }
              }
            },
            "failure_reasons": {"type": "array", "items": {"type": "string"}},
            "warnings": {"type": "array", "items": {"type": "string"}},
            "scoring_scope": {"type": "string"}
          }
        },
        "semantic_quality": {
          "type": "object",
          "required": [
            "policy_version",
            "reward_available",
            "realism_signal_score",
            "evidence_count",
            "signals",
            "scope"
          ],
          "properties": {
            "policy_version": {"const": "semantic-evidence-v1"},
            "reward_available": {"type": "boolean"},
            "reward": {"type": "number", "minimum": 0, "maximum": 1},
            "reward_source": {"type": "string"},
            "realism_signal_score": {"type": "number", "minimum": 0, "maximum": 100},
            "evidence_count": {"type": "integer", "minimum": 0},
            "signals": {"type": "object"},
            "scope": {"type": "string"}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
