{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XS-MLVP/ChipTrace/schemas/session-v1.schema.json",
  "title": "ChipTrace canonical Session v1",
  "type": "object",
  "required": [
    "schema_version",
    "trajectory_id",
    "session_id",
    "provider",
    "model",
    "created_at",
    "status",
    "is_final_snapshot",
    "source_request_count",
    "system_prompt",
    "tools",
    "messages",
    "usage",
    "meta"
  ],
  "properties": {
    "schema_version": {"const": "chiptrace.session.v1"},
    "trajectory_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "ended_at": {"type": ["string", "null"]},
    "status": {
      "enum": [
        "completed",
        "terminated",
        "failed",
        "cancelled",
        "canceled",
        "incomplete"
      ]
    },
    "is_final_snapshot": {"type": "boolean"},
    "source_request_count": {"type": "integer", "minimum": 0},
    "source_capture_count": {"type": "integer", "minimum": 1},
    "system_prompt": {"type": "string"},
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/toolDefinition"}
    },
    "messages": {
      "type": "array",
      "items": {"$ref": "#/$defs/message"}
    },
    "usage": {
      "type": ["object", "null"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "meta": {"$ref": "#/$defs/sessionMeta"},
    "quality": {"type": "object"}
  },
  "$defs": {
    "toolDefinition": {
      "type": "object",
      "required": [
        "name",
        "description",
        "parameters",
        "schema_hash",
        "schema_version"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "runtime_tool": {"type": "string", "minLength": 1},
        "runtime_namespace": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "parameters": {"type": "object"},
        "type": {"type": "string"},
        "schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"type": ["string", "integer"]},
        "native_format": {},
        "schema_provenance": {
          "type": "object",
          "required": ["source", "source_complete", "generated_adapter"],
          "properties": {
            "source": {"enum": ["captured_json_schema", "captured_native_format", "missing"]},
            "source_complete": {"type": "boolean"},
            "adapter_version": {"type": ["string", "null"]},
            "generated_adapter": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "toolCall": {
      "type": "object",
      "required": ["id", "type", "function", "execution_status"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "type": {"type": "string"},
        "function": {
          "type": "object",
          "required": ["name", "arguments"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "arguments": {"type": "string"}
          },
          "additionalProperties": true
        },
        "execution_status": {
          "enum": ["executed", "failed", "unknown", "open_tail", "unpaired"]
        },
        "result_status": {"type": "string"},
        "result_message_index": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant", "tool"]},
        "content": {},
        "tool_calls": {
          "type": "array",
          "items": {"$ref": "#/$defs/toolCall"}
        },
        "tool_call_id": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "is_error": {"type": "boolean"},
        "status_source": {"type": "string"},
        "status_conflict": {"type": "boolean"},
        "reasoning": {},
        "thinking": {},
        "meta": {"type": "object"}
      },
      "additionalProperties": true
    },
    "captureDag": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "roots",
        "tips",
        "open_tail_call_ids",
        "unresolved_parent_response_ids",
        "has_cycle",
        "disposition_counts"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "capture_id", "disposition", "lifecycle_events", "trace"],
            "properties": {
              "node_id": {"type": "string"},
              "capture_id": {"type": "string"},
              "record_type": {
                "enum": ["api_snapshot", "lifecycle_event", "tool_execution", "evaluation", "rollout_event"]
              },
              "response_id": {"type": ["string", "null"]},
              "previous_response_id": {"type": ["string", "null"]},
              "timestamp": {"type": "string"},
              "terminal_status": {"type": ["string", "null"]},
              "http_status": {"type": ["integer", "null"]},
              "disposition": {"enum": ["executed", "retry", "abandoned", "open_tail"]},
              "lifecycle_events": {"type": "array", "items": {"type": "string"}},
              "lifecycle_event_records": {"type": "array", "items": {"type": "object"}},
              "trace": {"type": "object"}
            },
            "additionalProperties": true
          }
        },
        "edges": {"type": "array"},
        "roots": {"type": "array", "items": {"type": "string"}},
        "tips": {"type": "array", "items": {"type": "string"}},
        "open_tail_call_ids": {"type": "array", "items": {"type": "string"}},
        "unresolved_parent_response_ids": {"type": "array", "items": {"type": "string"}},
        "unresolved_parent_span_ids": {"type": "array", "items": {"type": "string"}},
        "has_cycle": {"type": "boolean"},
        "disposition_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "runtimeDag": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "native_event_count",
        "nodes",
        "edges",
        "roots",
        "open_node_ids",
        "unresolved_node_ids",
        "status_conflict_node_ids",
        "terminal_rollout_ids",
        "kind_counts",
        "disposition_counts",
        "complete",
        "applicable"
      ],
      "properties": {
        "schema_version": {"const": "chiptrace.runtime-dag.v1"},
        "source": {"const": "codex_rollout_trace_bundle"},
        "native_event_count": {"type": "integer", "minimum": 0},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "node_type", "source_id", "trace_id", "status", "disposition"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "node_type": {
                "enum": ["rollout", "thread", "turn", "inference", "code_cell", "tool", "compaction"]
              },
              "source_id": {"type": "string", "minLength": 1},
              "trace_id": {"type": "string", "minLength": 1},
              "status": {
                "enum": ["running", "completed", "failed", "cancelled", "aborted", "terminated", "timeout", "incomplete"]
              },
              "disposition": {"enum": ["executed", "retry", "abandoned", "open_tail"]},
              "started_seq": {"type": "integer", "minimum": 0},
              "ended_seq": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "kind"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "root_mode": {"enum": ["single_rollout", "task_scoped_rollout_forest"]},
        "task_session_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "open_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unresolved_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "status_conflict_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "terminal_rollout_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "kind_counts": {"type": "object"},
        "disposition_counts": {"type": "object"},
        "complete": {"type": "boolean"},
        "applicable": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "inferenceApiConservation": {
      "type": "object",
      "required": [
        "schema_version",
        "matching_policy",
        "applicable",
        "complete",
        "runtime_completed_inferences",
        "runtime_correlatable_inferences",
        "api_snapshots",
        "api_correlatable_snapshots",
        "matched_runtime_inferences",
        "coverage",
        "missing_api_capture_keys",
        "runtime_without_correlation_capture_ids",
        "duplicate_runtime_keys",
        "extra_api_capture_keys",
        "api_without_correlation_capture_ids"
      ],
      "properties": {
        "schema_version": {"const": "chiptrace.inference-api-conservation.v1"},
        "matching_policy": {"type": "string", "minLength": 1},
        "applicable": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "runtime_completed_inferences": {"type": "integer", "minimum": 0},
        "runtime_correlatable_inferences": {"type": "integer", "minimum": 0},
        "api_snapshots": {"type": "integer", "minimum": 0},
        "api_correlatable_snapshots": {"type": "integer", "minimum": 0},
        "matched_runtime_inferences": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_api_capture_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "runtime_without_correlation_capture_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "duplicate_runtime_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "extra_api_capture_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "api_without_correlation_capture_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "taskDag": {
      "type": "object",
      "required": [
        "root_session_id",
        "nodes",
        "edges",
        "unresolved_parent_session_ids",
        "complete"
      ],
      "properties": {
        "root_session_id": {"type": "string"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["session_id", "role", "detachable"],
            "properties": {
              "session_id": {"type": "string"},
              "trajectory_id": {"type": ["string", "null"]},
              "parent_session_id": {"type": ["string", "null"]},
              "agent_id": {"type": ["string", "null"]},
              "branch_id": {"type": ["string", "null"]},
              "role": {"enum": ["root", "subagent"]},
              "detachable": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "edges": {"type": "array"},
        "unresolved_parent_session_ids": {"type": "array", "items": {"type": "string"}},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "sessionMeta": {
      "type": "object",
      "required": [
        "source_request_ids",
        "response_ids",
        "session_identity_source",
        "source_namespace",
        "capture_dag",
        "runtime_dag",
        "inference_api_conservation",
        "task_dag",
        "task_role",
        "lifecycle_events",
        "tool_executions",
        "tool_execution_conflicts",
        "producer_streams",
        "producer_event_conflicts",
        "evaluation_evidence",
        "schema_conflicts",
        "trace_conflicts",
        "usage_evidence",
        "usage_settlement_evidence",
        "usage_conflicts",
        "rollout_events",
        "rollout_usage_evidence",
        "rollout_unknown_events",
        "rollout_unmapped_tools",
        "merge_divergences",
        "model_evidence",
        "trace"
      ],
      "properties": {
        "source_request_ids": {"type": "array", "items": {"type": "string"}},
        "source_client_request_ids": {"type": "array", "items": {"type": "string"}},
        "source_capture_ids": {"type": "array", "items": {"type": "string"}},
        "response_ids": {"type": "array", "items": {"type": "string"}},
        "session_identity_source": {"type": "string"},
        "source_namespace": {"type": "string"},
        "trace_contexts": {"type": "array", "items": {"type": "object"}},
        "capture_dag": {"$ref": "#/$defs/captureDag"},
        "runtime_dag": {"$ref": "#/$defs/runtimeDag"},
        "inference_api_conservation": {"$ref": "#/$defs/inferenceApiConservation"},
        "task_dag": {"$ref": "#/$defs/taskDag"},
        "task_role": {"enum": ["root", "subagent"]},
        "lifecycle_events": {"type": "array", "items": {"type": "string"}},
        "lifecycle_event_records": {"type": "array", "items": {"type": "object"}},
        "turn_ids": {"type": "array", "items": {"type": "string"}},
        "previous_response_ids": {"type": "array", "items": {"type": "string"}},
        "tool_executions": {"type": "array", "items": {"type": "object"}},
        "tool_execution_conflicts": {"type": "array", "items": {"type": "string"}},
        "producer_streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "producer",
              "stream_id",
              "first_sequence",
              "last_sequence",
              "event_count",
              "capture_ids",
              "duplicate_sequences",
              "duplicate_event_ids",
              "gaps",
              "contiguous"
            ],
            "properties": {
              "producer": {"type": "string", "minLength": 1},
              "stream_id": {"type": "string", "minLength": 1},
              "producer_versions": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "first_sequence": {"type": "integer", "minimum": 0},
              "last_sequence": {"type": "integer", "minimum": 0},
              "event_count": {"type": "integer", "minimum": 1},
              "capture_ids": {"type": "array", "items": {"type": "string"}},
              "duplicate_sequences": {
                "type": "array",
                "items": {"type": "integer", "minimum": 0},
                "uniqueItems": true
              },
              "duplicate_event_ids": {"type": "boolean"},
              "gaps": {"type": "array", "items": {"type": "object"}},
              "contiguous": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "producer_event_conflicts": {"type": "array", "items": {"type": "string"}},
        "tool_registry_evidence": {"type": "array", "items": {"type": "object"}},
        "field_evidence": {"type": "array", "items": {"type": "object"}},
        "protocol_conflicts": {"type": "array", "items": {"type": "object"}},
        "system_prompt_evidence": {"type": "array", "items": {"type": "object"}},
        "system_prompt_conflicts": {"type": "array", "items": {"type": "string"}},
        "system_prompt_variants": {"type": "array", "items": {"type": "string"}},
        "evaluation_evidence": {"type": "array", "items": {"type": "object"}},
        "schema_conflicts": {"type": "array", "items": {"type": "string"}},
        "observed_schema_conflicts": {"type": "array", "items": {"type": "string"}},
        "uncalled_schema_conflicts": {"type": "array", "items": {"type": "string"}},
        "trace_conflicts": {"type": "array", "items": {"type": "string"}},
        "usage_evidence": {"type": "array", "items": {"type": "object"}},
        "usage_settlement_evidence": {"type": "array", "items": {"type": "object"}},
        "usage_conflicts": {"type": "array", "items": {"type": "string"}},
        "rollout_events": {"type": "array", "items": {"type": "object"}},
        "rollout_usage_evidence": {"type": "array", "items": {"type": "object"}},
        "rollout_unknown_events": {"type": "array", "items": {"type": "string"}},
        "rollout_unmapped_tools": {"type": "array", "items": {"type": "string"}},
        "code_mode_message_projection": {
          "type": "object",
          "required": [
            "schema_version",
            "evidence",
            "excluded_parent_call_ids",
            "excluded_tool_calls",
            "excluded_tool_results",
            "excluded_empty_messages",
            "raw_runtime_events_retained"
          ],
          "properties": {
            "schema_version": {"const": "chiptrace.code-mode-message-projection.v1"},
            "evidence": {"const": "codex_rollout_trace_bundle.code_cell_started.model_visible_call_id"},
            "excluded_parent_call_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "excluded_tool_calls": {"type": "integer", "minimum": 0},
            "excluded_tool_results": {"type": "integer", "minimum": 0},
            "excluded_empty_messages": {"type": "integer", "minimum": 0},
            "raw_runtime_events_retained": {"const": true}
          },
          "additionalProperties": false
        },
        "quality_projections": {
          "type": "object",
          "properties": {
            "buyer_v7_codex_runtime_expanded": {
              "type": "object",
              "required": [
                "schema_version",
                "profile_version",
                "excluded_model_call_ids",
                "runtime_messages",
                "runtime_tools",
                "code_mode_audit"
              ],
              "properties": {
                "schema_version": {"const": "chiptrace.session-quality-projection.v1"},
                "profile_version": {"const": "buyer-v7-codex-runtime-expanded"},
                "excluded_model_call_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "runtime_messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
                "runtime_tools": {"type": "array", "items": {"$ref": "#/$defs/toolDefinition"}},
                "code_mode_audit": {"type": "object"},
                "wire_schema_conflicts": {"type": "array", "items": {"type": "string"}},
                "wire_uncalled_schema_conflicts": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "merge_divergences": {"type": "integer", "minimum": 0},
        "model_evidence": {
          "type": "object",
          "required": [
            "request_models",
            "response_models",
            "effective_models",
            "providers",
            "consistent",
            "proxy_route_verified",
            "provider_identity_attested",
            "attested",
            "scope"
          ],
          "properties": {
            "request_models": {"type": "array", "items": {"type": "string"}},
            "response_models": {"type": "array", "items": {"type": "string"}},
            "gateway_requested_models": {"type": "array", "items": {"type": "string"}},
            "gateway_upstream_models": {"type": "array", "items": {"type": "string"}},
            "effective_models": {"type": "array", "items": {"type": "string"}},
            "providers": {"type": "array", "items": {"type": "string"}},
            "provider_candidates": {"type": "array", "items": {"type": "string"}},
            "gateway_providers": {"type": "array", "items": {"type": "string"}},
            "model_mapping_chains": {"type": "array", "items": {"type": "string"}},
            "gateway_evidence": {"type": "array", "items": {"type": "object"}},
            "provider_evidence": {"type": "array", "items": {"type": "object"}},
            "conflicts": {"type": "array", "items": {"type": "string"}},
            "consistent": {"type": "boolean"},
            "proxy_route_verified": {"type": "boolean"},
            "provider_identity_attested": {"type": "boolean"},
            "api_snapshot_count": {"type": "integer", "minimum": 0},
            "attestation_candidate_count": {"type": "integer", "minimum": 0},
            "non_attestable_api_snapshots": {"type": "array", "items": {"type": "object"}},
            "attested": {"type": "boolean"},
            "scope": {"type": "string"}
          },
          "additionalProperties": true
        },
        "trace": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
