{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XS-MLVP/ChipTrace/schemas/codex-trace-bundle-v1.schema.json",
  "title": "Codex native rollout trace bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "rollout_id",
    "root_thread_id",
    "started_at_unix_ms",
    "raw_event_log",
    "payloads_dir"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "rollout_id": {"type": "string", "minLength": 1},
    "root_thread_id": {"type": "string", "minLength": 1},
    "started_at_unix_ms": {"type": "integer", "minimum": 0},
    "raw_event_log": {"type": "string", "minLength": 1},
    "payloads_dir": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
