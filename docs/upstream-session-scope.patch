+
+    fn record_response_context(&self, response: &ClientResponsePayload) {
+        let thread_id = match response {
+            ClientResponsePayload::ThreadStart(response) => Some(response.thread.id.as_str()),
+            ClientResponsePayload::ThreadResume(response) => Some(response.thread.id.as_str()),
+            ClientResponsePayload::ThreadFork(response) => Some(response.thread.id.as_str()),
+            _ => None,
+        };
+        if let Some(thread_id) = thread_id {
+            self.span.record("conversation.id", thread_id);
+            self.span.record("codex.context_scope", "session");
+        }
     }
 }

