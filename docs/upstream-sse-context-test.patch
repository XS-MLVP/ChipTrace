+#[derive(Clone, Default)]
+struct OtlpSpanCollector {
+    span_ids: Arc<Mutex<Vec<Id>>>,
+}
+
+impl<S> Layer<S> for OtlpSpanCollector
+where
+    S: Subscriber + for<'a> LookupSpan<'a>,
+{
+    fn on_event(&self, event: &Event<'_>, ctx: LayerContext<'_, S>) {
+        if event.metadata().target() == "codex_otel.log_only"
+            && let Some(span_id) = ctx.current_span().id()
+        {
+            self.span_ids.lock().unwrap().push(span_id.clone());
+        }
+    }
+}
