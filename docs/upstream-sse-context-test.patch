+#[test]
+fn sse_callback_reenters_the_request_span_after_creation_scope_ends() {
+    let collector = OtlpSpanCollector::default();
+    let _subscriber = tracing_subscriber::registry()
+        .with(collector.clone())
+        .set_default();
+    let request_span = tracing::info_span!("native_turn_request", turn_id = "turn-1");
+    let telemetry = request_span.in_scope(|| {
+        super::ApiTelemetry::new(
+            test_session_telemetry(),
+            super::AuthRequestTelemetryContext::default(),
+            super::RequestRouteTelemetry::for_endpoint("/responses"),
+            super::AuthEnvTelemetry::default(),
+        )
+    });
+    let unrelated_span = tracing::info_span!("unrelated_turn", turn_id = "turn-2");
+    let _guard = unrelated_span.enter();
+    let response: std::result::Result<
+        Option<
+            std::result::Result<
+                eventsource_stream::Event,
+                eventsource_stream::EventStreamError<TransportError>,
+            >,
+        >,
+        tokio::time::error::Elapsed,
+    > = Ok(Some(Ok(eventsource_stream::Event {
+        event: "response.created".to_string(),
+        data: "{}".to_string(),
+        id: String::new(),
+        retry: None,
+    })));
+    telemetry.on_sse_poll(&response, Duration::from_millis(1));
+    let observed = collector.span_ids.lock().unwrap();
+    assert_eq!(observed.as_slice(), &[request_span.id()]);
+    assert_ne!(observed.as_slice(), &[unrelated_span.id()]);
+}
