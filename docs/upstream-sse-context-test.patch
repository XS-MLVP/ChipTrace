+async fn assert_terminal_event_request_span(
+    event: std::result::Result<ResponseEvent, ApiError>,
+    expected_success: bool,
+) {
+    let collector = OtlpSpanCollector::default();
+    let _subscriber = tracing_subscriber::registry()
+        .with(collector.clone())
+        .set_default();
+    let request_span = tracing::info_span!("native_turn_request", turn_id = "turn-1");
+    assert!(request_span.id().is_some());
+    let (mut stream, _) = request_span.in_scope(|| {
+        super::map_response_events(
+            Some("req-original".to_string()),
+            futures::stream::iter([event]),
+            test_session_telemetry(),
+            InferenceTraceAttempt::disabled(),
+            test_model_provider(),
+            tracing::Span::current(),
+        )
+    });
+    // Poll only after leaving the creation scope. Another Turn's context must
+    // not become the owner when the detached mapper emits terminal telemetry.
+    let unrelated_span = tracing::info_span!("unrelated_turn", turn_id = "turn-2");
+    let mapped = stream
+        .next()
+        .instrument(unrelated_span.clone())
+        .await
+        .expect("terminal event");
+    assert_eq!(mapped.is_ok(), expected_success);
+    assert_eq!(
+        collector.span_ids.lock().unwrap().as_slice(),
+        &[request_span.id()]
+    );
+    assert_ne!(request_span.id(), unrelated_span.id());
+}
