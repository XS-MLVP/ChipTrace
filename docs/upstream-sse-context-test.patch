+#[tokio::test(flavor = "current_thread")]
+async fn parallel_response_terminals_keep_their_creation_spans() {
+    let collector = OtlpSpanCollector::default();
+    let _subscriber = tracing_subscriber::registry()
+        .with(collector.clone())
+        .set_default();
+    let first_span = tracing::info_span!("first_request", turn_id = "turn-1");
+    let second_span = tracing::info_span!("second_request", turn_id = "turn-2");
+    assert!(first_span.id().is_some());
+    assert_ne!(first_span.id(), second_span.id());
+    let (first_tx, first_rx) = tokio::sync::oneshot::channel();
+    let (second_tx, second_rx) = tokio::sync::oneshot::channel();
+    let make_stream = |span: &tracing::Span, receiver: tokio::sync::oneshot::Receiver<()>| {
+        span.in_scope(|| {
+            super::map_response_events(
+                None,
+                futures::stream::once(async move {
+                    receiver.await.expect("release provider event");
+                    Ok(ResponseEvent::Completed {
+                        response_id: "resp".to_string(),
+                        token_usage: Some(Default::default()),
+                        usage_metadata: None,
+                        end_turn: Some(true),
+                    })
+                })
+                .boxed(),
+                test_session_telemetry(),
+                InferenceTraceAttempt::disabled(),
+                test_model_provider(),
+                tracing::Span::current(),
+            )
+            .0
+        })
+    };
+    let mut first = make_stream(&first_span, first_rx);
+    let mut second = make_stream(&second_span, second_rx);
+    // Both mapper tasks are live. Complete the second request first while the
+    // consumer is in the other Turn, then do the reverse for the first request.
+    second_tx.send(()).expect("release second request");
+    assert!(
+        second
+            .next()
+            .instrument(first_span.clone())
+            .await
+            .unwrap()
+            .is_ok()
+    );
+    first_tx.send(()).expect("release first request");
+    assert!(
+        first
+            .next()
+            .instrument(second_span.clone())
+            .await
+            .unwrap()
+            .is_ok()
+    );
+    assert_eq!(
+        collector.span_ids.lock().unwrap().as_slice(),
+        &[second_span.id(), first_span.id()]
+    );
+}
