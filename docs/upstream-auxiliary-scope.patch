+/// Splits one SDK export batch by native Session identity before it reaches the
+/// OTLP exporter.  The shared app-server/exec-server process can batch spans and
+/// logs from several Sessions; a mixed telemetry batch cannot be attributed to
+/// one Session downstream, so each Session gets its own HTTP batch.  Records
+/// without a Session identity stay together in one process batch.
+#[derive(Debug)]
+struct SessionSplittingExporter<E> {
+    exporter: E,
+}
+
+fn span_session_key(attributes: &[KeyValue]) -> Option<String> {
+    attributes.iter().find_map(|kv| {
+        matches!(kv.key.as_str(), "conversation.id" | "session.id" | "turn.id")
+            .then(|| kv.value.as_str().into_owned())
+    })
+}
+
+fn log_session_key(record: &SdkLogRecord) -> Option<String> {
+    record.attributes_iter().find_map(|(key, value)| {
+        if !matches!(key.as_str(), "conversation.id" | "session.id" | "turn.id") {
+            return None;
+        }
+        match value {
+            AnyValue::String(text) => Some(text.as_str().to_owned()),
+            _ => None,
+        }
+    })
+}
+
+impl<E: SpanExporterTrait> SpanExporterTrait for SessionSplittingExporter<E> {
+    async fn export(&self, batch: Vec<SpanData>) -> OTelSdkResult {
+        let mut groups: BTreeMap<String, Vec<SpanData>> = BTreeMap::new();
+        for span in batch {
+            let key = span_session_key(&span.attributes).unwrap_or_else(|| "process".to_owned());
+            groups.entry(key).or_default().push(span);
+        }
+        for group in groups.into_values() {
+            self.exporter.export(group).await?;
+        }
+        Ok(())
+    }
+
+    fn shutdown_with_timeout(&mut self, timeout: Duration) -> OTelSdkResult {
+        self.exporter.shutdown_with_timeout(timeout)
+    }
+
+    fn force_flush(&mut self) -> OTelSdkResult {
+        self.exporter.force_flush()
+    }
+
+    fn set_resource(&mut self, resource: &Resource) {
+        self.exporter.set_resource(resource);
+    }
+}
+
+impl<E: LogExporterTrait> LogExporterTrait for SessionSplittingExporter<E> {
+    async fn export(&self, batch: LogBatch<'_>) -> OTelSdkResult {
+        let mut groups: BTreeMap<String, Vec<(&SdkLogRecord, &InstrumentationScope)>> =
+            BTreeMap::new();
+        for (record, scope) in batch.iter() {
+            let key = log_session_key(record).unwrap_or_else(|| "process".to_owned());
+            groups.entry(key).or_default().push((record, scope));
+        }
+        for group in groups.into_values() {
+            self.exporter.export(LogBatch::new(&group)).await?;
+        }
+        Ok(())
+    }
+
+    fn shutdown_with_timeout(&self, timeout: Duration) -> OTelSdkResult {
+        self.exporter.shutdown_with_timeout(timeout)
+    }
+
+    fn set_resource(&mut self, resource: &Resource) {
+        self.exporter.set_resource(resource);
+    }
+}
