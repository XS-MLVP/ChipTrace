+//! Runtime Tool Registry payload stored in a raw rollout bundle.
+
+use serde::Serialize;
+use serde_json::Value;
+
+/// Wire version consumed by lossless trace exporters.
+pub const RUNTIME_TOOL_REGISTRY_SCHEMA_VERSION: &str = "codex.runtime-tool-registry.v1";
+
+/// Exact dispatcher registry active for one Codex turn.
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct RuntimeToolRegistrySnapshot {
+    pub schema_version: &'static str,
+    pub producer: &'static str,
+    pub producer_version: String,
+    pub tools: Vec<RuntimeToolRegistryEntry>,
+}
+
+impl RuntimeToolRegistrySnapshot {
+    pub fn new(producer_version: impl Into<String>, tools: Vec<RuntimeToolRegistryEntry>) -> Self {
+        Self {
+            schema_version: RUNTIME_TOOL_REGISTRY_SCHEMA_VERSION,
+            producer: "codex-cli",
+            producer_version: producer_version.into(),
+            tools,
+        }
+    }
+}
+
+/// One executable runtime tool and its source definition.
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct RuntimeToolRegistryEntry {
+    pub runtime_item_type: String,
+    pub runtime_tool: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub runtime_namespace: Option<String>,
+    pub tool: Value,
+}
+
+impl RuntimeToolRegistryEntry {
+    pub fn new(
+        runtime_item_type: impl Into<String>,
+        runtime_tool: impl Into<String>,
+        runtime_namespace: Option<String>,
+        tool: Value,
+    ) -> Self {
+        Self {
+            runtime_item_type: runtime_item_type.into(),
+            runtime_tool: runtime_tool.into(),
+            runtime_namespace,
+            tool,
+        }
+    }
+}
