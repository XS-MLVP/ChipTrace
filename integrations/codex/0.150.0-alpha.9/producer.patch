+#[test]
+fn runtime_tool_registry_is_ordered_before_dispatch_and_deduplicated() -> anyhow::Result<()> {
+    let temp = TempDir::new()?;
+    let thread_id = ThreadId::new();
+    let thread_trace =
+        ThreadTraceContext::start_root_in_root_for_test(temp.path(), minimal_metadata(thread_id))?;
+    let snapshot = RuntimeToolRegistrySnapshot::new(
+        "0.150.0-alpha.9",
+        vec![RuntimeToolRegistryEntry::new(
+            "function",
+            "exec_command",
+            Some("functions".to_string()),
+            serde_json::json!({
+                "type":"function",
+                "name":"exec_command",
+                "description":"Execute a command.",
+                "parameters":{"type":"object","properties":{}}
+            }),
+        )],
+    );
+    let changed_snapshot = RuntimeToolRegistrySnapshot::new(
+        "0.150.0-alpha.9",
+        vec![RuntimeToolRegistryEntry::new(
+            "custom",
+            "apply_patch",
+            Some("functions".to_string()),
+            serde_json::json!({
+                "type":"custom",
+                "name":"apply_patch",
+                "description":"Apply a patch.",
+                "format":{"type":"grammar","syntax":"lark","definition":"start: /.+/"}
+            }),
+        )],
+    );
+
+    thread_trace.record_tool_registry_snapshot("turn-1", &snapshot);
+    thread_trace.record_tool_registry_snapshot("turn-1", &snapshot);
+    thread_trace.record_tool_registry_snapshot("turn-2", &changed_snapshot);
+    thread_trace.record_tool_registry_snapshot("turn-3", &snapshot);
+
+    let bundle_dir = single_bundle_dir(temp.path())?;
+    let events = fs::read_to_string(bundle_dir.join("trace.jsonl"))?
+        .lines()
+        .map(serde_json::from_str::<crate::RawTraceEvent>)
+        .collect::<Result<Vec<_>, _>>()?;
+    let registry_events = events
+        .iter()
+        .filter_map(|event| match &event.payload {
+            RawTraceEventPayload::Other { kind, payloads, .. }
+                if kind == "tool_registry_snapshot" =>
+            {
+                Some((event, payloads))
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(registry_events.len(), 3);
+    assert_eq!(
+        registry_events[0].0.codex_turn_id.as_deref(),
+        Some("turn-1")
+    );
+    let payload_path = bundle_dir.join(&registry_events[0].1[0].path);
+    let payload: serde_json::Value = serde_json::from_slice(&fs::read(payload_path)?)?;
+    assert_eq!(payload, serde_json::to_value(snapshot)?);
+    assert_eq!(
+        registry_events[1].0.codex_turn_id.as_deref(),
+        Some("turn-2")
+    );
+    assert_eq!(
+        registry_events[2].0.codex_turn_id.as_deref(),
+        Some("turn-3")
+    );
+    Ok(())
+}
