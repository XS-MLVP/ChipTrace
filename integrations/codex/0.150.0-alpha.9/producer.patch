@@ -0,0 +1,124 @@
+//! Lossless projection of the executable core registry into rollout evidence.
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::bail;
+use codex_rollout_trace::RuntimeToolRegistryEntry;
+use codex_rollout_trace::RuntimeToolRegistrySnapshot;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde_json::json;
+
+use crate::tools::registry::ToolRegistry;
+
+pub(crate) fn runtime_tool_registry_snapshot(
+    registry: &ToolRegistry,
+) -> Result<RuntimeToolRegistrySnapshot> {
+    let mut tools = registry
+        .entries()
+        .map(|registered| {
+            let runtime_name = registered.runtime.tool_name().with_default_namespace();
+            let spec = registered.runtime.spec();
+            runtime_registry_entry(&runtime_name, &spec)
+        })
+        .collect::<Result<Vec<_>>>()?;
+    tools.sort_by(|left, right| {
+        left.runtime_namespace
+            .cmp(&right.runtime_namespace)
+            .then(left.runtime_tool.cmp(&right.runtime_tool))
+    });
+    if tools.is_empty() {
+        bail!("runtime Tool Registry is empty");
+    }
+    Ok(RuntimeToolRegistrySnapshot::new(
+        env!("CARGO_PKG_VERSION"),
+        tools,
+    ))
+}
+
+fn runtime_registry_entry(
+    runtime_name: &ToolName,
+    spec: &ToolSpec,
+) -> Result<RuntimeToolRegistryEntry> {
+    let (runtime_item_type, mut tool) = match spec {
+        ToolSpec::Function(function) => {
+            ensure_runtime_name(runtime_name, &function.name)?;
+            ("function", serde_json::to_value(spec)?)
+        }
+        ToolSpec::Freeform(freeform) => {
+            ensure_runtime_name(runtime_name, &freeform.name)?;
+            ("custom", serde_json::to_value(spec)?)
+        }
+        ToolSpec::Namespace(namespace) => {
+            let child = namespace
+                .tools
+                .iter()
+                .find(|child| namespace_tool_name(child) == runtime_name.name)
+                .with_context(|| {
+                    format!(
+                        "runtime tool {} is absent from namespace {}",
+                        runtime_name.name, namespace.name
+                    )
+                })?;
+            let runtime_item_type = match child {
+                ResponsesApiNamespaceTool::Function(_) => "function",
+                ResponsesApiNamespaceTool::Custom(_) => "custom",
+            };
+            let mut value = serde_json::to_value(child)?;
+            value["namespace"] = json!(namespace.name);
+            (runtime_item_type, value)
+        }
+        ToolSpec::ToolSearch {
+            execution,
+            description,
+            parameters,
+        } => {
+            ensure_runtime_name(runtime_name, "tool_search")?;
+            (
+                "tool_search",
+                json!({
+                    "type":"tool_search",
+                    "name":"tool_search",
+                    "execution":execution,
+                    "description":description,
+                    "parameters":parameters,
+                }),
+            )
+        }
+        ToolSpec::WebSearch { .. } => {
+            bail!("hosted web_search must not appear in the executable runtime Tool Registry")
+        }
+    };
+    let object = tool
+        .as_object_mut()
+        .context("runtime Tool Registry definition must serialize as an object")?;
+    object.insert("runtime_name".to_string(), json!(runtime_name));
+    Ok(RuntimeToolRegistryEntry::new(
+        runtime_item_type,
+        runtime_name.name.clone(),
+        runtime_name.namespace.clone(),
+        tool,
+    ))
+}
+
+fn ensure_runtime_name(runtime_name: &ToolName, definition_name: &str) -> Result<()> {
+    if runtime_name.name != definition_name {
+        bail!(
+            "runtime tool {} does not match definition {definition_name}",
+            runtime_name.name
+        );
+    }
+    Ok(())
+}
+
+fn namespace_tool_name(tool: &ResponsesApiNamespaceTool) -> &str {
+    match tool {
+        ResponsesApiNamespaceTool::Function(tool) => &tool.name,
+        ResponsesApiNamespaceTool::Custom(tool) => &tool.name,
+    }
+}
+
+#[cfg(test)]
+#[path = "tool_registry_trace_tests.rs"]
+mod tests;
