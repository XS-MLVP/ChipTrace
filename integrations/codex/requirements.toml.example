# Install as /etc/codex/requirements.toml.
# Validated with Stock Codex 0.163.0-alpha.11.
# SessionStart fails closed when cloud ingest is unavailable.
# Exact requirements prevent user/profile/session overrides from bypassing Wire capture.
model_provider = "OpenAI"

[model_providers.OpenAI]
name = "OpenAI-compatible Gateway"
base_url = "http://172.28.11.121:18084/"
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false
request_max_retries = 25
stream_max_retries = 25
auth = { command = "printenv", args = ["CHIPTRACE_API_KEY"] }

[features]
hooks = true

[hooks]

[[hooks.SessionStart]]
[[hooks.SessionStart.hooks]]
type = "command"
command = "/bin/sh -c 'test -n \"$CHIPTRACE_API_KEY\" && test -n \"$CHIPTRACE_INGEST_TOKEN\" && test \"$OTEL_EXPORTER_OTLP_HEADERS\" = \"Authorization=Bearer%20$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c \"import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\\\"event_id\\\",str(uuid.uuid4())); event.setdefault(\\\"occurred_at\\\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\\\",\\\",\\\":\\\")))\") && /usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --fail --silent --show-error --retry 1 --retry-all-errors --retry-delay 0 --retry-max-time 2 --connect-timeout 0.5 --max-time 1 -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex >/dev/null || /usr/bin/printf \"%s\\n\" \"{\\\"continue\\\":false,\\\"stopReason\\\":\\\"ChipTrace cloud ingest unavailable or configuration incomplete\\\"}\"'"
timeout = 3
statusMessage = "验证云端 Trace 采集入口"

[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
type = "command"
command = "/bin/sh -c 'test -n \"$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c \"import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\\\"event_id\\\",str(uuid.uuid4())); event.setdefault(\\\"occurred_at\\\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\\\",\\\",\\\":\\\")))\") && /usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --fail --silent --show-error --retry 1 --retry-all-errors --retry-delay 0 --retry-max-time 2 --connect-timeout 0.5 --max-time 1 -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex >/dev/null'"
timeout = 3

[[hooks.Interrupt]]
[[hooks.Interrupt.hooks]]
type = "command"
command = "/bin/sh -c 'test -n \"$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c \"import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\\\"event_id\\\",str(uuid.uuid4())); event.setdefault(\\\"occurred_at\\\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\\\",\\\",\\\":\\\")))\") && /usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --fail --silent --show-error --retry 1 --retry-all-errors --retry-delay 0 --retry-max-time 2 --connect-timeout 0.5 --max-time 1 -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex >/dev/null'"
timeout = 3

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "/bin/sh -c 'test -n \"$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c \"import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\\\"event_id\\\",str(uuid.uuid4())); event.setdefault(\\\"occurred_at\\\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\\\",\\\",\\\":\\\")))\") && /usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --fail --silent --show-error --retry 1 --retry-all-errors --retry-delay 0 --retry-max-time 2 --connect-timeout 0.5 --max-time 1 -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex >/dev/null'"
timeout = 3

[[hooks.PreCompact]]
[[hooks.PreCompact.hooks]]
type = "command"
command = "/bin/sh -c 'test -n \"$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c \"import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\\\"event_id\\\",str(uuid.uuid4())); event.setdefault(\\\"occurred_at\\\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\\\",\\\",\\\":\\\")))\") && /usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --fail --silent --show-error --retry 1 --retry-all-errors --retry-delay 0 --retry-max-time 2 --connect-timeout 0.5 --max-time 1 -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex >/dev/null'"
timeout = 3

