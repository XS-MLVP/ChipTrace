# Install as /etc/codex/requirements.toml.
# Routing validated with the official Stock Codex 0.163.0 ELF.
# Install integrations/codex/chiptrace-codex-hook.sh as
# /usr/local/libexec/chiptrace-codex-hook (0755) before starting Codex.
# SessionStart fails closed when cloud ingest is unavailable.
# Every Hook requires HTTP 200 and a conserved, error-free Relay durable receipt.
# Set CHIPTRACE_GATEWAY_URL to the same Gateway used by config.toml.  The
# helper defaults to a local 127.0.0.1:18084 Gateway for single-host installs.
# Set CHIPTRACE_INGEST_TOKEN or CHIPTRACE_INGEST_TOKEN_FILE; the provider key
# and OTLP header are intentionally not prerequisites for lifecycle delivery.
# Exact requirements prevent user/profile/session overrides from bypassing Wire capture.
model_provider = "OpenAI"

[model_providers.OpenAI]
name = "OpenAI-compatible Gateway"
# Same-host default. Remote/sidecar deployments must replace this with the
# exact Gateway address and set CHIPTRACE_GATEWAY_URL for the Hook helper.
base_url = "http://127.0.0.1:18084/"
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false
request_max_retries = 25
stream_max_retries = 25
auth = { command = "printenv", args = ["CHIPTRACE_API_KEY"] }

[features]
hooks = true

[hooks]

[[hooks.SessionStart]]
[[hooks.SessionStart.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=SessionStart exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3
statusMessage = "验证云端 Trace 采集入口"

[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=SessionEnd exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.Interrupt]]
[[hooks.Interrupt.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=Interrupt exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=UserPromptSubmit exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.PreCompact]]
[[hooks.PreCompact.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=PreCompact exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.PostCompact]]
[[hooks.PostCompact.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=PostCompact exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=Stop exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.SubagentStart]]
[[hooks.SubagentStart.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=SubagentStart exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3

[[hooks.SubagentStop]]
[[hooks.SubagentStop.hooks]]
type = "command"
command = "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=SubagentStop exec \"${CHIPTRACE_HOOK_BIN:-/usr/local/libexec/chiptrace-codex-hook}\"'"
timeout = 3
