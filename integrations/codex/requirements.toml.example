command = "/bin/sh -c 'test -n \"$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c \"import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\\\"event_id\\\",str(uuid.uuid4())); event.setdefault(\\\"occurred_at\\\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\\\",\\\",\\\":\\\")))\") && /usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --fail --silent --show-error --retry 1 --retry-all-errors --retry-delay 0 --retry-max-time 2 --connect-timeout 0.5 --max-time 1 -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex >/dev/null'"
timeout = 3
