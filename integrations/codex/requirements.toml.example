[[hooks.PreCompact.hooks]]
type = "command"
command = "/bin/sh -c 'deliver_hook() { for attempt in 1 2; do if ack=$(/usr/bin/printf \"%s\" \"$event\" | /usr/bin/curl --disable --fail --silent --show-error --connect-timeout 0.5 --max-time 1 --max-filesize 65536 --write-out '\\''\n%{http_code}'\\'' -H \"Authorization: Bearer $CHIPTRACE_INGEST_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://172.28.11.121:18084/hooks/codex); then /usr/bin/printf \"%s\" \"$ack\" | /usr/bin/python3 -c '\\''import json,sys\ntry:\n    wire=sys.stdin.read(65537)\n    body,status=wire.rsplit(\"\\n\",1)\n    value=json.loads(body)\n    receipt=value[\"chiptrace\"]\n    summary=receipt[\"summary\"]\n    partial=value[\"partialSuccess\"]\n    counts={\"source_records\":1,\"derived_captures\":1,\"unknown_events\":0,\"attributed_quality_errors\":0}\n    valid=(len(wire)<=65536 and status==\"200\" and receipt[\"ok\"] is True and receipt[\"durable\"] is True\n        and type(receipt[\"captures\"]) is int and receipt[\"captures\"]==2\n        and type(receipt[\"duplicates\"]) is int and 0<=receipt[\"duplicates\"]<=2\n        and summary[\"endpoint\"]==\"codex_hook\"\n        and all(type(summary[key]) is int and summary[key]==count for key,count in counts.items())\n        and summary[\"conversion_errors\"]==[]\n        and all(type(partial[key]) is int and partial[key]==0 for key in (\"rejectedLogRecords\",\"rejectedSpans\"))\n        and partial[\"errorMessage\"] is None)\nexcept (ValueError,TypeError,KeyError,AttributeError):\n    valid=False\nsys.exit(0 if valid else \"ChipTrace Hook durable ACK invalid\")'\\''; return $?; fi; done; return 1; }; test -n \"$CHIPTRACE_INGEST_TOKEN\" && event=$(/usr/bin/python3 -c '\\''import json,sys,uuid,datetime; event=json.load(sys.stdin); event.setdefault(\"event_id\",str(uuid.uuid4())); event.setdefault(\"occurred_at\",datetime.datetime.now(datetime.timezone.utc).isoformat()); print(json.dumps(event,separators=(\",\",\":\")))'\\'') && deliver_hook'"
