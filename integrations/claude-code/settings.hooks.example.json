  "hooks": {
    "SessionStart": [{"matcher": "", "hooks": [{"type": "command", "command": "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=SessionStart CHIPTRACE_GATEWAY_URL=http://127.0.0.1:18084 CHIPTRACE_INGEST_TOKEN_FILE=/etc/chiptrace/ingest-token CHIPTRACE_CLAUDE_STATE_DIR=/var/lib/chiptrace/claude-turn-state CHIPTRACE_MODEL=deepseek-flash CHIPTRACE_PERMISSION_MODE=bypassPermissions exec /usr/local/libexec/chiptrace-claude-hook'", "timeout": 5}]}],
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "/bin/sh -c 'CHIPTRACE_HOOK_EVENT=UserPromptSubmit CHIPTRACE_GATEWAY_URL=http://127.0.0.1:18084 CHIPTRACE_INGEST_TOKEN_FILE=/etc/chiptrace/ingest-token CHIPTRACE_CLAUDE_STATE_DIR=/var/lib/chiptrace/claude-turn-state CHIPTRACE_MODEL=deepseek-flash CHIPTRACE_PERMISSION_MODE=bypassPermissions exec /usr/local/libexec/chiptrace-claude-hook'", "timeout": 5}]}],
