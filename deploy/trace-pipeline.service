[Unit]
Description=Agent 轨迹采集服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/trace-training-pipeline
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/trace-training-pipeline/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env trace-pipeline serve --root %h/.local/share/trace-pipeline/capture --state-root %h/.local/state/trace-pipeline --host 127.0.0.1 --port 3010 --segment-max-mib 512 --max-envelope-mib 1024 --max-inflight-body-mib 4096
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
