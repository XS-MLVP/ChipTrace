[Unit]
Description=ChipTrace Stock Codex rollout delivery agent
Documentation=https://github.com/XS-MLVP/ChipTrace
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/chiptrace/codex-agent.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env chiptrace codex-agent --queue-root %h/.local/state/chiptrace/outbox --session-root %h/.codex/sessions --state-root %h/.local/state/chiptrace/agent --relay-url ${CHIPTRACE_RELAY_URL} --source-namespace ${CHIPTRACE_SOURCE_NAMESPACE} --retry-max-times 25 --poll-ms 1000
Restart=on-failure
RestartSec=3s
TimeoutStopSec=35s
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=default.target
