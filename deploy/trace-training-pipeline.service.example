[Unit]
Description=Trace training collector canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=%h/trace-training-pipeline/src
ExecStart=/usr/bin/python3 -m trace_pipeline serve --root %h/trace-data/capture --state-root %h/trace-data/state --host 127.0.0.1 --port 3011 --segment-max-mib 512 --max-envelope-mib 1024 --max-inflight-body-mib 4096
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
