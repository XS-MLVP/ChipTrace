#!/bin/sh

if [ -n "${CHIPTRACE_BIN:-}" ]; then
  CHIPTRACE_EXECUTABLE="${CHIPTRACE_BIN}"
elif [ -x "${HOME:-}/.local/bin/chiptrace" ]; then
  CHIPTRACE_EXECUTABLE="${HOME}/.local/bin/chiptrace"
else
  CHIPTRACE_EXECUTABLE="chiptrace"
fi
if [ -n "${CHIPTRACE_STATE_ROOT:-}" ]; then
  CHIPTRACE_LOCAL_STATE="${CHIPTRACE_STATE_ROOT}"
elif [ -n "${XDG_STATE_HOME:-}" ]; then
  CHIPTRACE_LOCAL_STATE="${XDG_STATE_HOME}/chiptrace"
else
  [ -n "${HOME:-}" ] || exit 0
  CHIPTRACE_LOCAL_STATE="${HOME}/.local/state/chiptrace"
fi

# Collection is fail-open for the Agent. Errors remain visible locally and the
# absent spool event makes the resulting Trace incomplete downstream.
mkdir -p "${CHIPTRACE_LOCAL_STATE}" 2>/dev/null || exit 0
"${CHIPTRACE_EXECUTABLE}" codex-hook-spool \
  --queue-root "${CHIPTRACE_LOCAL_STATE}/outbox" \
  >/dev/null 2>>"${CHIPTRACE_LOCAL_STATE}/hook-errors.log" || :
exit 0
